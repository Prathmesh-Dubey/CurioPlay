{
  "name": "curioplay-frontend",
  "private": true,
  "version": "1.0.0",
  "homepage": "https://prathmesh-dubey.github.io/CurioPlay/",
  "type": "module",
  "scripts": {
    "snapshot": "node scripts/snapshot-catalog.mjs",
    "predev": "npm run snapshot",
    "dev": "vite",
    "prebuild:web": "npm run snapshot",
    "prebuild:android": "npm run snapshot",
    "build": "npm run build:web && npm run build:android",
    "build:web": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build:web",
    "deploy": "gh-pages -d dist --dotfiles",
    "lint": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "build:android": "vite build --mode android",
    "android:sync": "vite build --mode android && cap sync android"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.7",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "idb-keyval": "6.3.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
